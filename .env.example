# Пример настроек. Скопировать в hackathon/.env и заполнить своими значениями.
# Файл .env в репозиторий не попадает: он в .gitignore.

# Yandex Cloud: поиск и языковая модель
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# OpenAlex: бесплатный ключ на openalex.org/settings/api.
# С февраля 2026 параметр mailto отменён, дневной бюджет привязан к ключу.
OPENALEX_API_KEY=

# Google Custom Search (не используется, режим «по всему интернету» отключён Google)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- Публичный MVP (нужно только при развёртывании на открытом адресе) ---
# Имя, по которому открыт сервис: свой домен либо 203-0-113-7.sslip.io, если домена нет.
RADAR_HOST=
# Ограничители бюджета. Живой прогон ≈ 60 ₽ поиска и 30 ₽ модели, идёт 7–11 минут.
RADAR_DAILY_RUNS=6
RADAR_IP_DAILY_RUNS=2
RADAR_RUN_TIMEOUT=1200
# Пусто — запуск открыт всем. Строка — запуск только по токену, сохранённые разборы открыты.
RADAR_PUBLIC_TOKEN=
