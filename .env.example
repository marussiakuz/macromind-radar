# Пример настроек. Скопировать в hackathon/.env и заполнить своими значениями.
# Файл .env в репозиторий не попадает: он в .gitignore.

# Yandex Cloud: поиск и языковая модель
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# OpenAlex: бесплатный ключ на openalex.org/settings/api.
# С февраля 2026 параметр mailto отменён, дневной бюджет привязан к ключу.
OPENALEX_API_KEY=

# Google Custom Search (не используется, режим «по всему интернету» отключён Google)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
