# Скопируйте файл в .env в корне репозитория. Ключи нужны только для нового анализа.
# После изменения настроек: docker compose up -d --force-recreate
RADAR_DEMO=1
RADAR_PORT=8000

# Веб-поиск: ключ Yandex Search API и идентификатор каталога Yandex Cloud.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Дополнительный поиск научных публикаций (OpenAlex).
OPENALEX_API_KEY=

# Модель по умолчанию: Yandex AI Studio. {folder} заменяется YANDEX_FOLDER_ID.
RADAR_MODEL=gpt://{folder}/qwen3.6-35b-a3b
RADAR_LLM_URL=https://llm.api.cloud.yandex.net/v1/chat/completions
# Пусто для Yandex — используется YANDEX_API_KEY. Для своего сервера это отдельный ключ.
RADAR_LLM_API_KEY=
# Для медленной локальной модели можно увеличить, например до 300 секунд.
RADAR_LLM_TIMEOUT_S=90
# Пусто: Api-Key для Yandex, Bearer для остальных серверов.
RADAR_LLM_AUTH_SCHEME=
# Пусто: none для Yandex, параметр не передаётся другим серверам.
RADAR_LLM_REASONING_EFFORT=

# Расчётные цены, рубли: за поисковый вызов и за миллион токенов модели.
# Для локальной модели без оплаты за токены установите оба тарифа модели в 0.
RADAR_PRICE_SEARCH=0.488
RADAR_PRICE_INPUT_MTOK=200
RADAR_PRICE_OUTPUT_MTOK=300
# Минимальные остатки для старта. Это не верхняя граница цены анализа.
RADAR_RUN_COST_SEARCH=60
RADAR_RUN_COST_LLM=200

# Ограничения корпуса и времени; снижение числа пакетов уменьшает полноту.
RADAR_EXTRACTION_PACKETS=200
RADAR_MAX_PER_SOURCE=999
# Пустое значение отключает отсечение по дате. Документы без даты сохраняются.
RADAR_MIN_PUBLISHED=2024-01-01
RADAR_RUN_DEADLINE_S=3600

# Публичный доступ: необязательно для localhost.
RADAR_HOST=
RADAR_DAILY_RUNS=6
RADAR_IP_DAILY_RUNS=2
# Через это время интерфейс предупреждает о долгом анализе. Поток не останавливается.
RADAR_RUN_TIMEOUT=1200
# Токен ограничивает новые запуски. Готовые результаты и API чтения остаются открыты.
RADAR_PUBLIC_TOKEN=
RADAR_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
