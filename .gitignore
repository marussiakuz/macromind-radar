# Белый список: по умолчанию не попадает ничего.
# В корне лежат договоры, презентации, таблица заказчика и Pre-DD — публиковать их
# нельзя, поэтому перечисляем то, что входит, а не то, что исключаем.
/*
!/.gitignore
!/.env.example
!/README.md
!/DOCUMENTATION.md

# Публикация статического интерфейса на GitHub Pages
!/.github/
/.github/*
!/.github/workflows/

# Конвейер радара
!/hackathon/
/hackathon/*
!/hackathon/radar/
!/hackathon/*.md
!/hackathon/.gitignore
!/hackathon/requirements.txt
# Развёртывание публичного MVP: образ, compose, HTTPS-прокси, сборщик посылки состояния
!/hackathon/Dockerfile
!/hackathon/docker-compose.yml
!/hackathon/Caddyfile
!/hackathon/deploy/
# Посылка состояния собирается локально и содержит учёт расходов: не в репозиторий
/hackathon/deploy/*.tar.gz
# Настоящая выборка одного прогона: инструменты и тесты работают без сети и без оплаты
!/hackathon/samples/
# Опыты: датасет ранжирования, обучение реранкера, замеры покрытия, карточка модели
!/hackathon/learning/

# Интерфейс
!/tech-trend-searcher/
/tech-trend-searcher/*
!/tech-trend-searcher/src/
!/tech-trend-searcher/index.html
!/tech-trend-searcher/package.json
!/tech-trend-searcher/package-lock.json
!/tech-trend-searcher/tsconfig.json
!/tech-trend-searcher/vite.config.ts
!/tech-trend-searcher/README.md

# Общий стенд сравнения реализаций
!/bench/
/bench/pool-*.json

# Внутри разрешённых каталогов — всё равно без секретов и мусора
.env
.env.*
!.env.example
*.key
*.pem
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
node_modules/
dist/
.DS_Store
.git-standalone-backup/
# Данные прогонов: 415 МБ сохранённых страниц. Для проверки достаточно hackathon/samples/
radar-runs/
# Учёт расходов: локальное состояние, не артефакт
ledger.json
ledger.lock
