# Белый список: по умолчанию не попадает ничего.
# В корне лежат договоры, презентации, таблица заказчика и Pre-DD — публиковать их
# нельзя, поэтому перечисляем то, что входит, а не то, что исключаем.
/*
!/.gitignore
!/.env.example
!/README.md
!/DOCUMENTATION.md

# Публикация статического интерфейса на GitHub Pages
!/.github/
/.github/*
!/.github/workflows/

# Конвейер радара
!/hackathon/
/hackathon/*
!/hackathon/radar/
!/hackathon/.gitignore
# Документы публикуем поимённо. Переписка с ассистентами, промпты для них, точки
# возврата и их промежуточные отчёты в продуктовый репозиторий не входят: жюри должно
# видеть работающее решение, а не журнал работы над ним.
!/hackathon/architecture-2026-09-29.md
!/hackathon/deploy-mvp-2026-09-29.md
!/hackathon/submission-methodology-2026-09-28.md
!/hackathon/reference-funnel-audit-2026-09-29.md
!/hackathon/methods-weak-signals.md
!/hackathon/runbook-demo-2026-09-28.md
!/hackathon/screencast-script-2026-09-29.md
!/hackathon/requirements.txt
# Развёртывание публичного MVP: образ, compose, HTTPS-прокси, сборщик посылки состояния
!/hackathon/Dockerfile
!/hackathon/docker-compose.yml
!/hackathon/Caddyfile
!/hackathon/deploy/
# Посылка состояния собирается локально и содержит учёт расходов: не в репозиторий
/hackathon/deploy/*.tar.gz
# Настоящая выборка одного прогона: инструменты и тесты работают без сети и без оплаты
!/hackathon/samples/
# Опыты: только то, на что ссылается документация, — карточка модели, её обучение и
# датасет оценок. Промежуточные выгрузки разметки моделью не публикуем.
!/hackathon/learning/
/hackathon/learning/*
!/hackathon/learning/reranker-card-20260929.json
!/hackathon/learning/train_reranker.py
!/hackathon/learning/rank-dataset-20260929.json

# Интерфейс
!/tech-trend-searcher/
/tech-trend-searcher/*
!/tech-trend-searcher/src/
!/tech-trend-searcher/index.html
!/tech-trend-searcher/package.json
!/tech-trend-searcher/package-lock.json
!/tech-trend-searcher/tsconfig.json
!/tech-trend-searcher/vite.config.ts
!/tech-trend-searcher/README.md

# Стенд сравнения двух реализаций — рабочий артефакт, в продуктовый репозиторий не идёт

# Внутри разрешённых каталогов — всё равно без секретов и мусора
.env
.env.*
!.env.example
*.key
*.pem
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
node_modules/
dist/
.DS_Store
.git-standalone-backup/
# Данные прогонов: 415 МБ сохранённых страниц. Для проверки достаточно hackathon/samples/
radar-runs/
# Учёт расходов: локальное состояние, не артефакт
ledger.json
ledger.lock
